load("//build/kernel/kleaf:kernel.bzl", "kernel_module")

kernel_module(
    name = "pogo_transport",
    srcs = glob([
        "*.c",
        "*.h",
        "Kbuild",
    ]) + [
        "//private/google-modules/whi-staging/bms:headers",
        "//private/google-modules/whi-staging/soc/gs:gs_soc_headers",
    ],
    outs = [
        "pogo_transport.ko",
    ],
    kernel_build = "//private/google-modules/whi-staging/soc/gs:gs_kernel_build",
    visibility = [
        "//private/devices/google:__subpackages__",
    ],
    deps = [
        "//private/google-modules/whi-staging/bms",
        "//private/google-modules/whi-staging/soc/gs:gs_soc_module",
    ],
)
