DEVICE_DIR=private/devices/google/tangorpro
SOC_DIR=private/google-modules/soc/gs

# These just need to be relative to the ROOT_DIR
FRAGMENT_CONFIG="private/devices/google/pantah/pantah_gki.fragment ${DEVICE_DIR}/tangorpro_gki.fragment"
. ${ROOT_DIR}/private/devices/google/gs201/build.config.gs201

DTC_INCLUDE=${ROOT_DIR}/${SOC_DIR}/include/dtc
MKDTIMG_FLAGS="--page_size=4096 --id=/:board_id --rev=/:board_rev"
