    name = "tangorpro_modules_install",
    kernel_build = ":tangorpro",
    kernel_modules = [":tangorpro_ext_modules"],
)

merged_kernel_uapi_headers(
    name = "tangorpro_merged_uapi_headers",
    kernel_build = ":tangorpro",
    kernel_modules = [":tangorpro_ext_modules"],
)

kernel_unstripped_modules_archive(
    name = "tangorpro_unstripped_modules_archive",
    kernel_build = ":tangorpro",
    kernel_modules = [":tangorpro_ext_modules"],
)

genrule(
    name = "vendor_kernel_boot_modules.tangorpro-cat",
    srcs = [
        "vendor_kernel_boot_modules.tangorpro",
        "//build/kernel:hermetic-tools/cat",
        "//private/google-modules/soc/gs:vendor_kernel_boot_modules.gs201",
    ],
    outs = [
        "vendor_kernel_boot_modules.concat",
    ],
    # TODO(b/259274243): switch to using the hermetic-tools cat binary
    cmd = """
        cat $(location vendor_kernel_boot_modules.tangorpro) \\
            $(location //private/google-modules/soc/gs:vendor_kernel_boot_modules.gs201) \\
            > $@
    """,
    tools = ["//build/kernel:hermetic-tools/cat"],
)

# TODO: Add support to disable a list of GKI modules
_GKI_MODULES_LIST = get_gki_modules_list("arm64")

write_file(
    name = "system_dlkm_modules_list",
    out = "system_dlkm_modules_list.tangorpro",
    content = _GKI_MODULES_LIST,
)

kernel_images(
    name = "tangorpro_images",
    base_kernel_images = "//common:kernel_aarch64_images_download_or_build",
    boot_image_outs = ["dtb.img"],
    build_boot = False,
    build_dtbo = True,
    build_initramfs = True,
    build_system_dlkm = True,
    build_vendor_dlkm = True,
    build_vendor_kernel_boot = True,
    dedup_dlkm_modules = True,
    dtbo_srcs = [":tangorpro/" + file for file in _TANGORPRO_DTBOS],
    kernel_build = ":tangorpro",
    kernel_modules_install = ":tangorpro_modules_install",
    # Keep the following in sync with build.config.tangorpro:
    modules_list = ":vendor_kernel_boot_modules.tangorpro-cat",
    system_dlkm_modules_list = ":system_dlkm_modules_list",
    system_dlkm_props = "//private/google-modules/soc/gs:system_dlkm.props",
    vendor_dlkm_etc_files = ["//private/devices/google/tangorpro:insmod_cfgs"],
    vendor_dlkm_modules_blocklist = "//private/google-modules/soc/gs:vendor_dlkm.blocklist.gs201",
    # No MODULES_BLOCKLIST
    vendor_dlkm_modules_list = "//private/google-modules/soc/gs:vendor_dlkm_modules.slider",
    vendor_dlkm_props = "//private/google-modules/soc/gs:vendor_dlkm.props",
    deps = [
        # Keep the following in sync with vendor_dlkm.props:
        # selinux_fc
        "//prebuilts/boot-artifacts/selinux:vendor_dlkm_file_contexts",
        "//prebuilts/boot-artifacts/selinux:system_dlkm_file_contexts",
    ],
)

filegroup(
    name = "insmod_cfgs",
    srcs = glob([
        "insmod_cfg/*.cfg",
    ]),
)

_tangorpro_dist_targets = [
    ":tangorpro",
    ":tangorpro_images",
    "//private/google-modules/soc/gs:gki_aarch64_boot",
    # At the time of writing (2022-02-04), this intentionally diverges from
    # the behavior of build.sh-style mixed builds by also incorporating
    # UAPI headers of external modules, while build.sh-style mixed builds
    # always uses kernel-uapi-headers.tar.gz from GKI_DIST_DIR.
    # To use GKI's kernel-uapi-headers.tar.gz in DIST_DIR, use
    #     //common:kernel_aarch64_uapi_headers
    # instead.
    ":tangorpro_merged_uapi_headers",
    ":tangorpro_modules_install",
    ":tangorpro_unstripped_modules_archive",
    ":insmod_cfgs",
    "//common:android/abi_gki_aarch64_pixel",
    "//common:kernel_aarch64_download_or_build",
] + ["//common:kernel_aarch64/{}".format(m) for m in _GKI_MODULES_LIST]

copy_to_dist_dir(
    name = "tangorpro_dist_copy_to_dist_dir",
    data = _tangorpro_dist_targets,
    dist_dir = "out/tangorpro/dist",
    flat = True,
    log = "info",
)

exec(
    name = "tangorpro_dist",
    data = [":tangorpro_dist_copy_to_dist_dir"],
    script = """
        echo {gki_kernel_dir}: $(git -C $BUILD_WORKSPACE_DIRECTORY/{gki_kernel_dir} rev-parse HEAD)
        $(rootpath :tangorpro_dist_copy_to_dist_dir) $@
    """.format(gki_kernel_dir = "//common"),
)
