hermetic_genrule(
    name = "vendor_kernel_boot_modules.pantah-cat",
    srcs = [
        "vendor_kernel_boot_modules.pantah",
        "//private/google-modules/soc/gs:vendor_kernel_boot_modules.gs201",
    ],
    outs = [
        "vendor_kernel_boot_modules.concat",
    ],
    cmd = """
        cat $(location vendor_kernel_boot_modules.pantah) \\
            $(location //private/google-modules/soc/gs:vendor_kernel_boot_modules.gs201) \\
            > $@
    """,
)

# Don't load the zram GKI module
_GKI_MODULES = [m for m in get_gki_modules_list("arm64") if not m.endswith("zram.ko")]

write_file(
    name = "system_dlkm_modules_list",
    out = "system_dlkm_modules_list.pantah",
    content = _GKI_MODULES,
)

kernel_images(
    name = "gs201_pantah_images",
    base_kernel_images = select({
        "//private/google-modules/soc/gs:gki_aosp": "//aosp:kernel_aarch64_images_download_or_build",
        "//private/google-modules/soc/gs:gki_aosp_staging": "//aosp-staging:kernel_aarch64_images_download_or_build",
    }),
    boot_image_outs = ["dtb.img"],
    build_boot = False,
    build_dtbo = True,
    build_initramfs = True,
    build_system_dlkm = True,
    build_vendor_dlkm = True,
    build_vendor_kernel_boot = True,
    dedup_dlkm_modules = True,
    dtbo_srcs = [":gs201_pantah/" + file for file in _GS201_PANTAH_DTBOS],
    kernel_build = ":gs201_pantah",
    kernel_modules_install = ":gs201_pantah_modules_install",
    # Keep the following in sync with build.config.pantah:
    modules_list = ":vendor_kernel_boot_modules.pantah-cat",
    system_dlkm_modules_list = ":system_dlkm_modules_list",
    system_dlkm_props = "//private/google-modules/soc/gs:system_dlkm.props.gs201",
    vendor_dlkm_etc_files = ["//private/devices/google/pantah:insmod_cfgs"],
    vendor_dlkm_modules_blocklist = "//private/google-modules/soc/gs:vendor_dlkm.blocklist.gs201",
    # No MODULES_BLOCKLIST
    vendor_dlkm_modules_list = "//private/google-modules/soc/gs:vendor_dlkm_modules.gs201",
    vendor_dlkm_props = "//private/google-modules/soc/gs:vendor_dlkm.props.gs201",
    deps = [
        # Keep the following in sync with (vendor|system)_dlkm.props.gs201:
        # selinux_fc
        "//prebuilts/boot-artifacts/selinux:file_contexts",
        "//prebuilts/boot-artifacts/selinux:system_file_contexts",
    ],
)

