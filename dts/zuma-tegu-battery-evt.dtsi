/*
 * Battery device tree entries specific to tegu
 *
 * Copyright 2024 Google,LLC
 *
 */

&google_battery {
	google,chg-temp-limits = <0 100 200 440 460 480 550>;
	google,chg-cc-limits = <
		 30   10   10    0    0
		 50   30   30   30   30
		100  100  100  100   50
		 90   90   90   90   50
		 50   50   50    0    0
		 30    0    0    0    0
	>;
};
